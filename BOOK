#include <iostream>
using namespace std;

class Book
{
    int bookNumber;
    string bookName;
    float bookPrice;

public:

    
    Book(int number, string name, float price)
    {
        bookNumber = number;
        bookName = name;
        bookPrice = price;
    }

    
    void display()
    {
        cout << "Book Number : " << bookNumber << endl;
        cout << "Book Name   : " << bookName << endl;
        cout << "Book Price  : Rs. " << bookPrice << endl;
        cout << "------------------------" << endl;
    }
};

